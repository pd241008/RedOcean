# ═══════════════════════════════════════════════════════════════
# Application & Experiment Metadata
# ═══════════════════════════════════════════════════════════════
APP_NAME=RedOcean
APP_VERSION=0.1.0
APP_ENVIRONMENT=research
APP_DEBUG=false

# ═══════════════════════════════════════════════════════════════
# Optical Physics & Channel Defaults
# ═══════════════════════════════════════════════════════════════
DEFAULT_WATER_TYPE=ClearOcean       # PureSea | ClearOcean | CoastalOcean | TurbidHarbor
DEFAULT_TX_POWER_DBM=30.0           # 1.0 Watt average optical power (+30 dBm)
DEFAULT_APERTURE_DIAM_M=0.10        # 10 cm receiver aperture
DEFAULT_BEAM_DIVERGENCE_DEG=20.0    # 20 degree full angle
DEFAULT_POINTING_JITTER_SIGMA=0.05  # Spatial jitter standard deviation (m)
DEFAULT_SCINTILLATION_INDEX=0.04    # Weak-to-moderate oceanic turbulence

# ═══════════════════════════════════════════════════════════════
# Cryptographic & Protocol Parameters
# ═══════════════════════════════════════════════════════════════
PROTOCOL_NAME=LO-AKA
AEAD_PRIMITIVE=ASCON-128a
HANDSHAKE_BUDGET_BYTES=80
TARGET_OUTAGE_PROB=0.001

# ═══════════════════════════════════════════════════════════════
# Deterministic Simulation & Formal Proof Gates
# ═══════════════════════════════════════════════════════════════
SIM_RANDOM_SEED=42
SIM_TOTAL_HANDSHAKES=100000
ENABLE_LEAN4_RUNTIME_VERIFICATION=true
EXPORT_TELEMETRY_IPC=true
TELEMETRY_BATCH_SIZE=1000

